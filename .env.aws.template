# ========================================
# AWS CONFIGURATION (REQUIRED)
# ========================================

# AWS Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1

# AWS RDS PostgreSQL Database
RDS_HOST=meetingmind.ctousuwme9up.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=meetingmind
RDS_USER=postgres
RDS_PASSWORD=your_rds_password
RDS_SSL_MODE=prefer

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# AWS S3 Storage
S3_BUCKET_NAME=meetingmind-storage
S3_AUDIO_PREFIX=audio/
S3_EXPORT_PREFIX=exports/

# ========================================
# REDIS CONFIGURATION (for 2FA)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# AI & API SERVICES
# ========================================

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# RapidAPI (for transcription)
RAPIDAPI_KEY=your_rapidapi_key

# ========================================
# EMAIL CONFIGURATION
# ========================================

# Gmail SMTP
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
FROM_NAME=AI Meeting Assistant

# SendGrid (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=MeetingMind

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=8000
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin Configuration
ADMIN_EMAIL=admin@dynamicmeetingassistant.com
ADMIN_PASSWORD=admin123

