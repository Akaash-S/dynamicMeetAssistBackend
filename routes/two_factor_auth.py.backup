"""
Two-Factor Authentication Routes
Handles Email, SMS, and Authenticator App 2FA
"""

from flask import Blueprint, request, jsonify
from functools import wraps
import logging
from services.enhanced_2fa_security import enhanced_2fa_service
from services.email_service import email_service
from config.aws_rds_database import rds_db

logger = logging.getLogger(__name__)

two_factor_auth_bp = Blueprint('two_factor_auth', __name__)


def require_auth(f):
    """Decorator to require authentication"""
    @wraps(f)
    def decorated_function(*args, **kwargs):
        # Get user from session/token (implement based on your auth system)
        user_id = request.headers.get('X-User-ID')
        if not user_id:
            return jsonify({'error': 'Authentication required'}), 401
        return f(*args, **kwargs)
    return decorated_function


# Email 2FA Routes
@two_factor_auth_bp.route('/2fa/email/send', methods=['POST'])
@require_auth
def send_email_2fa_code():
    """Send verification code via email"""
    try:
        data = request.get_json()
        email = data.get('email')
        
        if not email:
            return jsonify({'error': 'Email is required'}), 400
        
        success, message = enhanced_2fa_service.send_email_verification_code(
            email,
            email_service
        )
        
        if success:
            return jsonify({
                'success': True,
                'message': message
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': message
            }), 400
    except Exception as e:
        logger.error(f"Error sending email 2FA code: {e}")
        return jsonify({'error': 'Internal server error'}), 500


@two_factor_auth_bp.route('/2fa/email/verify', methods=['POST'])
@require_auth
def verify_email_2fa_code():
    """Verify email 2FA code and enable 2FA"""
    try:
        data = request.get_json()
        code = data.get('code')
        user_id = request.headers.get('X-User-ID')
        
        if not code:
            return jsonify({'error': 'Verification code is required'}), 400
        
        # Get user email from database
        user = rds_db.execute_query(
            'SELECT email, name FROM users WHERE firebase_uid = %s',
            (user_id,, fetch_all=True),
            fetch_one=True
        )
        
        if not user:
            return jsonify({'error': 'User not found'}), 404
        
        email = user['email']
        
        # Verify code
        success, message = enhanced_2fa_service.verify_email_code(email, code)
        
        if success:
            # Enable 2FA in database
            rds_db.execute_query(
                '''
                UPDATE users 
                SET two_factor_enabled = TRUE,
                    two_factor_method = '2fa_email'
                WHERE firebase_uid = %s
                ''',
                (user_id,)
            )
            
            # Send confirmation email
            email_service.send_2fa_enabled_notification(email, user['name'], '2fa_email')
            
            return jsonify({
                'success': True,
                'message': 'Email 2FA enabled successfully'
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': message
            }), 400
    except Exception as e:
        logger.error(f"Error verifying email 2FA code: {e}")
        return jsonify({'error': 'Internal server error'}), 500


# SMS 2FA Routes
@two_factor_auth_bp.route('/2fa/sms/send', methods=['POST'])
@require_auth
def send_sms_2fa_code():
    """Send verification code via SMS"""
    try:
        data = request.get_json()
        phone_number = data.get('phoneNumber')
        
        if not phone_number:
            return jsonify({'error': 'Phone number is required'}), 400
        
        # Clean phone number (remove formatting)
        phone_number = ''.join(filter(str.isdigit, phone_number))
        
        # Add country code if not present (assuming US)
        if not phone_number.startswith('1') and len(phone_number) == 10:
            phone_number = '+1' + phone_number
        elif not phone_number.startswith('+'):
            phone_number = '+' + phone_number
        
        success, message = enhanced_2fa_service.send_sms_verification_code(phone_number)
        
        if success:
            return jsonify({
                'success': True,
                'message': message
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': message
            }), 400
    except Exception as e:
        logger.error(f"Error sending SMS 2FA code: {e}")
        return jsonify({'error': 'Internal server error'}), 500


@two_factor_auth_bp.route('/2fa/sms/verify', methods=['POST'])
@require_auth
def verify_sms_2fa_code():
    """Verify SMS 2FA code and enable 2FA"""
    try:
        data = request.get_json()
        code = data.get('code')
        phone_number = data.get('phoneNumber')
        user_id = request.headers.get('X-User-ID')
        
        if not code or not phone_number:
            return jsonify({'error': 'Code and phone number are required'}), 400
        
        # Clean phone number
        phone_number = ''.join(filter(str.isdigit, phone_number))
        if not phone_number.startswith('1') and len(phone_number) == 10:
            phone_number = '+1' + phone_number
        elif not phone_number.startswith('+'):
            phone_number = '+' + phone_number
        
        # Verify code
        success, message = enhanced_2fa_service.verify_sms_code(phone_number, code)
        
        if success:
            # Enable 2FA in database
            rds_db.execute_query(
                '''
                UPDATE users 
                SET two_factor_enabled = TRUE,
                    two_factor_method = '2fa_sms',
                    two_factor_phone = %s
                WHERE firebase_uid = %s
                ''',
                (phone_number, user_id)
            )
            
            # Get user info for notification
            user = rds_db.execute_query(
                'SELECT email, name FROM users WHERE firebase_uid = %s',
                (user_id,, fetch_all=True),
                fetch_one=True
            )
            
            if user:
                email_service.send_2fa_enabled_notification(
                    user['email'],
                    user['name'],
                    '2fa_sms'
                )
            
            return jsonify({
                'success': True,
                'message': 'SMS 2FA enabled successfully'
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': message
            }), 400
    except Exception as e:
        logger.error(f"Error verifying SMS 2FA code: {e}")
        return jsonify({'error': 'Internal server error'}), 500


# Authenticator App 2FA Routes
@two_factor_auth_bp.route('/2fa/app/setup', methods=['POST'])
@require_auth
def setup_authenticator_app():
    """Setup authenticator app (generate QR code and secret)"""
    try:
        user_id = request.headers.get('X-User-ID')
        
        # Get user email
        user = rds_db.execute_query(
            'SELECT email FROM users WHERE firebase_uid = %s',
            (user_id,, fetch_all=True),
            fetch_one=True
        )
        
        if not user:
            return jsonify({'error': 'User not found'}), 404
        
        email = user['email']
        
        # Generate QR code and secret
        success, data = enhanced_2fa_service.setup_authenticator_app(email)
        
        if success:
            return jsonify({
                'success': True,
                'secret': data['secret'],
                'qrCode': data['qrCode']
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': 'Failed to setup authenticator app'
            }), 400
    except Exception as e:
        logger.error(f"Error setting up authenticator app: {e}")
        return jsonify({'error': 'Internal server error'}), 500


@two_factor_auth_bp.route('/2fa/app/verify', methods=['POST'])
@require_auth
def verify_authenticator_app_code():
    """Verify authenticator app code and enable 2FA"""
    try:
        data = request.get_json()
        code = data.get('code')
        secret = data.get('secret')
        user_id = request.headers.get('X-User-ID')
        
        if not code or not secret:
            return jsonify({'error': 'Code and secret are required'}), 400
        
        # Get user email
        user = rds_db.execute_query(
            'SELECT email, name FROM users WHERE firebase_uid = %s',
            (user_id,, fetch_all=True),
            fetch_one=True
        )
        
        if not user:
            return jsonify({'error': 'User not found'}), 404
        
        email = user['email']
        
        # Verify code
        success, message = enhanced_2fa_service.verify_authenticator_code(
            email,
            code,
            secret
        )
        
        if success:
            # Enable 2FA in database
            rds_db.execute_query(
                '''
                UPDATE users 
                SET two_factor_enabled = TRUE,
                    two_factor_method = '2fa_app',
                    two_factor_secret = %s
                WHERE firebase_uid = %s
                ''',
                (secret, user_id)
            )
            
            # Send confirmation email
            email_service.send_2fa_enabled_notification(
                email,
                user['name'],
                '2fa_app'
            )
            
            return jsonify({
                'success': True,
                'message': 'Authenticator app 2FA enabled successfully'
            }), 200
        else:
            return jsonify({
                'success': False,
                'error': message
            }), 400
    except Exception as e:
        logger.error(f"Error verifying authenticator app code: {e}")
        return jsonify({'error': 'Internal server error'}), 500


# General 2FA Routes
@two_factor_auth_bp.route('/2fa/status', methods=['GET'])
@require_auth
def get_2fa_status():
    """Get 2FA status for current user"""
    try:
        user_id = request.headers.get('X-User-ID')
        
        user = rds_db.execute_query(
            '''
            SELECT two_factor_enabled, two_factor_method 
            FROM users 
            WHERE firebase_uid = %s
            ''',
            (user_id,, fetch_all=True),
            fetch_one=True
        )
        
        if not user:
            return jsonify({'error': 'User not found'}), 404
        
        return jsonify({
            'enabled': bool(user['two_factor_enabled']),
            'method': user['two_factor_method']
        }), 200
    except Exception as e:
        logger.error(f"Error getting 2FA status: {e}")
        return jsonify({'error': 'Internal server error'}), 500


@two_factor_auth_bp.route('/2fa/disable', methods=['POST'])
@require_auth
def disable_2fa():
    """Disable 2FA for current user"""
    try:
        user_id = request.headers.get('X-User-ID')
        
        rds_db.execute_query(
            '''
            UPDATE users 
            SET two_factor_enabled = FALSE,
                two_factor_method = NULL,
                two_factor_secret = NULL,
                two_factor_phone = NULL
            WHERE firebase_uid = %s
            ''',
            (user_id,)
        )
        
        return jsonify({
            'success': True,
            'message': '2FA disabled successfully'
        }), 200
    except Exception as e:
        logger.error(f"Error disabling 2FA: {e}")
        return jsonify({'error': 'Internal server error'}), 500


# Cleanup endpoint (should be called periodically)
@two_factor_auth_bp.route('/2fa/cleanup', methods=['POST'])
def cleanup_2fa_data():
    """Cleanup expired codes and temp secrets (internal use)"""
    try:
        enhanced_2fa_service.cleanup_expired_codes()
        enhanced_2fa_service.cleanup_temp_secrets()
        return jsonify({'success': True}), 200
    except Exception as e:
        logger.error(f"Error cleaning up 2FA data: {e}")
        return jsonify({'error': 'Internal server error'}), 500
