# AI Meeting Assistant Backend - Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# AWS CONFIGURATION
# ===========================================
# AWS Credentials
# Get these from AWS IAM Console: https://console.aws.amazon.com/iam/
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# AWS RDS PostgreSQL Database
# Create RDS instance: https://console.aws.amazon.com/rds/
RDS_HOST=your-db-instance.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=meetingmind
RDS_USER=postgres
RDS_PASSWORD=your_secure_rds_password

# AWS S3 Storage
# Create S3 bucket: https://console.aws.amazon.com/s3/
S3_BUCKET_NAME=meetingmind-storage
S3_AUDIO_PREFIX=audio/
S3_EXPORT_PREFIX=exports/

# ===========================================
# AI SERVICES CONFIGURATION
# ===========================================
# RapidAPI Key for Speech-to-Text Service
RAPIDAPI_KEY=your-rapidapi-key-here

# Google Gemini AI API Key
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# GOOGLE CALENDAR API CONFIGURATION
# ===========================================
# Google Calendar API Configuration (for backend server-side operations)
# These are OPTIONAL - only needed if you want backend calendar operations
GOOGLE_CALENDAR_API_KEY=your-google-calendar-api-key-here
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-client-secret-here
# Setup Instructions for Google Calendar Backend:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project OR use your existing Firebase project
# 3. Enable Google Calendar API: APIs & Services > Library > Google Calendar API > Enable
# 4. Create credentials:
#    - API Key: APIs & Services > Credentials > Create Credentials > API Key
#    - OAuth Client ID: APIs & Services > Credentials > Create Credentials > OAuth 2.0 Client IDs
#      * Choose "Web application" type
#      * Add authorized redirect URIs for your backend:
#        - https://dynamicmeetassistbackend-1.onrender.com/auth/google/callback (for development)
#        - https://your-backend-domain.com/auth/google/callback (for production)
# 5. Copy the Client ID and Client Secret to the variables above
# 6. Note: Client Secret is only needed for server-side operations, not frontend

# ===========================================
# FLASK CONFIGURATION
# ===========================================
# Flask Secret Key (generate a secure random string)
SECRET_KEY=your-super-secret-key-change-this-in-production

# Flask Environment (development/production)
FLASK_ENV=production

# Server Port (Render will set this automatically)
PORT=8000

# Production Gunicorn Settings
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120

# ===========================================
# EMAIL SERVICE CONFIGURATION
# ===========================================
# Option 1: Gmail SMTP (for development/testing)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
FROM_NAME=AI Meeting Assistant

# Option 2: SendGrid (recommended for production)
# Sign up at: https://sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=MeetingMind

# ===========================================
# TWO-FACTOR AUTHENTICATION (2FA)
# ===========================================
# Twilio Configuration (for SMS 2FA)
# Sign up at: https://www.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# 2FA Settings
TWO_FACTOR_CODE_EXPIRY=300
TWO_FACTOR_MAX_ATTEMPTS=5

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Maximum file upload size in bytes (default: 100MB)
MAX_FILE_SIZE=104857600

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=mp3,wav,m4a,mp4,webm

# CORS Configuration (Security Critical)
# Production: Set specific allowed origins (comma-separated, no spaces)
# Development: Can be left empty to allow localhost
CORS_ORIGINS=https://your-frontend-domain.com,https://your-app.vercel.app,https://your-app.netlify.app

# CORS Security Notes:
# - In production, CORS_ORIGINS MUST be set with your actual frontend domains
# - Never use '*' in production for security reasons
# - Include both HTTP and HTTPS versions if needed
# - No trailing slashes in URLs
# - Example: https://myapp.com,https://www.myapp.com,https://staging.myapp.com

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/meeting_assistant.log

# ===========================================
# CHATBOT CONFIGURATION
# ===========================================
# Groq API Configuration (for LLM)
# Sign up at: https://console.groq.com/
GROQ_API_KEY=your-groq-api-key-here
GROQ_API_KEY_TWO=your-second-groq-api-key-for-voice
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=1.0
GROQ_MAX_TOKENS=1024

# ElevenLabs Configuration (for Text-to-Speech)
# Sign up at: https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Embedding Model Configuration (Local - No API key needed)
# Uses sentence-transformers for embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector Store Configuration
VECTOR_STORE_PATH=./data/vectors
VECTOR_STORE_COLLECTION=user_data

# Chatbot Operational Parameters
CHATBOT_MAX_CONTEXT_LENGTH=4000
CHATBOT_MAX_HISTORY_MESSAGES=50
CHATBOT_RESPONSE_TIMEOUT=5
CHATBOT_INDEX_UPDATE_INTERVAL=60
CHATBOT_ENABLE_STREAMING=true

# Voice AI Configuration
VOICE_AI_ENABLED=true
VOICE_TRANSCRIPTION_MODEL=whisper-large-v3
VOICE_MAX_AUDIO_SIZE=25

# Chatbot Setup Instructions:
# 1. Groq Setup (Required for LLM):
#    - Sign up at: https://console.groq.com/
#    - Create API key in dashboard
#    - Add GROQ_API_KEY for chatbot
#    - Add GROQ_API_KEY_TWO for voice transcription (or use same key)
#
# 2. ElevenLabs Setup (Optional for TTS):
#    - Sign up at: https://elevenlabs.io/
#    - Get API key from profile settings
#    - Choose voice ID from voice library
#    - If not set, TTS will be disabled
#
# 3. Embeddings:
#    - Uses sentence-transformers (no API key needed)
#    - First run will download model (~90MB)
#
# 4. Vector Store:
#    - ChromaDB stores data locally in VECTOR_STORE_PATH
#    - Ensure directory has write permissions
#    - Data is user-isolated for privacy
#
# 5. Initialize Database:
#    - Run: python init_chatbot_db.py
#    - Creates chatbot_sessions and chatbot_messages tables

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================
# 1. Copy this file: cp env.example .env
# 2. Fill in all the required values above
# 3. For production, ensure all secrets are properly secured
# 4. Never commit the .env file to version control
#
# Required Services Setup:
# - AWS Account: https://aws.amazon.com/
#   * Create IAM user with RDS and S3 permissions
#   * Create RDS PostgreSQL instance
#   * Create S3 bucket for storage
#   * Run migration: backend/migrations/rds_schema.sql
# - RapidAPI: https://rapidapi.com/
# - Google AI Studio: https://makersuite.google.com/
#
# Optional Services:
# - SendGrid: https://sendgrid.com/ (for production emails)
# - Twilio: https://www.twilio.com/ (for SMS 2FA)
# - Gmail SMTP: Use App Passwords for authentication
#
# AWS Setup Guide:
# 1. Create IAM User:
#    - Go to IAM Console > Users > Add User
#    - Enable "Programmatic access"
#    - Attach policies: AmazonRDSFullAccess, AmazonS3FullAccess
#    - Save Access Key ID and Secret Access Key
#
# 2. Create RDS Instance:
#    - Go to RDS Console > Create Database
#    - Choose PostgreSQL engine
#    - Select instance size (t3.micro for dev)
#    - Set master username and password
#    - Configure security group to allow your IP
#    - Note the endpoint URL
#
# 3. Create S3 Bucket:
#    - Go to S3 Console > Create Bucket
#    - Choose unique bucket name
#    - Enable versioning (optional)
#    - Block public access (recommended)
#    - Enable server-side encryption
#
# 4. Run Database Migration:
#    psql -h your-rds-endpoint -U postgres -d meetingmind -f backend/migrations/rds_schema.sql
#
# Security Best Practices:
# - Use AWS Secrets Manager for production credentials
# - Enable MFA on AWS account
# - Rotate access keys regularly
# - Use least privilege IAM policies
# - Enable CloudTrail logging
# - Set up CloudWatch alarms
